<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wyh.mapper.EmpExprMapper">

    <!-- 批量插入工作经历 -->
    <insert id="insertBatch">
        INSERT INTO emp_expr (emp_id, `begin`, `end`, company, job) VALUES
        <foreach collection="empExprs" item="expr" separator=",">
            (#{expr.empId}, #{expr.begin}, #{expr.end}, #{expr.company}, #{expr.job})
        </foreach>
    </insert>
    <!-- 批量删除工作经历 -->
    <delete id="deleteEmpExprByIds">
        DELETE FROM emp_expr WHERE emp_id IN
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>
    <!-- 根据emp_id查询工作经历 -->
    <select id="getEmpExprById" resultType="com.wyh.pojo.EmpExpr">
        SELECT * FROM emp_expr WHERE emp_id = #{id}
    </select>

</mapper>